<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <Target Name="DebPackage" Condition="'$(OS)' == 'Unix' AND '$(MacOS)' != 'true'" DependsOnTargets="Stage" AfterTargets="Package">
    <PropertyGroup>
      <TempFolder>temp</TempFolder>
      <PackageDebFolder>eng/package/deb</PackageDebFolder>
      <PackageTempFolder>$(PackageDebFolder)/$(TempFolder)</PackageTempFolder>
    </PropertyGroup>

    <ItemGroup>
      <StdLibFiles Include="$(StageDir)/$(StdLibDirName)/**/*.*" />
    </ItemGroup>

    <ItemGroup>
      <ApplicationFiles Include="$(StageDir)/net10.0/ipy" Condition="Exists('$(StageDir)/net10.0/ipy')" />
      <ApplicationFiles Include="$(StageDir)/net10.0/ipy.exe" Condition="Exists('$(StageDir)/net10.0/ipy.exe')" />
      <ApplicationFiles Include="$(StageDir)/net10.0/*.exe" Condition="'$(OS)' == 'Windows_NT'" />
      <ApplicationFiles Include="$(StageDir)/net10.0/*.dll" Exclude="$(StageDir)/net10.0/IronPython.SQLite.dll;$(StageDir)/net10.0/IronPython.Wpf.dll" />
      <ApplicationFiles Include="$(StageDir)/net10.0/DLLs/*.dll" />
    </ItemGroup>

    <ItemGroup>
      <UnixExecutableFiles Include="$(StageDir)/net10.0/ipy" Condition="Exists('$(StageDir)/net10.0/ipy')" />
      <UnixExecutableFiles Include="$(StageDir)/net10.0/ipy.exe" Condition="Exists('$(StageDir)/net10.0/ipy.exe')" />
    </ItemGroup>

    <ItemGroup>
      <ScriptFiles Include="$(PackageDebFolder)/ipy*" />
    </ItemGroup>

    <!-- Build the application deb -->
    <Exec Command="chmod 755 %(UnixExecutableFiles.Identity)" Condition="'@(UnixExecutableFiles)' != ''" />
    <Exec Command="rm -rf $(PackageTempFolder)" />
    <Exec Command="mkdir -p $(PackageTempFolder)/DEBIAN" />
    <Exec Command="cp $(PackageDebFolder)/DEBIAN/* $(PackageTempFolder)/DEBIAN"/>

    <FileUpdate Files="$(PackageTempFolder)/DEBIAN/control"
          Expression="{xxx}"
          Replacement="$(PackageVersion)" />

    <ItemGroup>
      <StdLibOutputFiles Include="$(StageDir)/$(StdLibDirName)/**/*.py" />
    </ItemGroup>
    <Exec Command="sed -i 's/\r$//' %(StdLibOutputFiles.Identity)" />
    <Exec Command="sed -i 's/\r$//' $(PackageTempFolder)/DEBIAN/control"/>

    <Copy SourceFiles="@(ScriptFiles)" DestinationFolder="$(PackageTempFolder)/usr/bin/"/>
    <Copy SourceFiles="@(ApplicationFiles)" DestinationFolder="$(PackageTempFolder)/usr/share/cyberstone-ironpython3.15/%(ApplicationFiles.RecursiveDir)"/>
    <Copy SourceFiles="@(StdLibFiles)" DestinationFolder="$(PackageTempFolder)/usr/lib/cyberstone-ironpython3.15/%(StdLibFiles.RecursiveDir)"/>

    <Exec Command="fakeroot dpkg-deb -v --build $(PackageTempFolder)"/>
    <Copy
      SourceFiles="$(PackageDebFolder)/$(TempFolder).deb"
      DestinationFiles="$(PackageDir)/cyberstone-ironpython_$(PackageVersion).deb"/>
    <Delete Files="$(PackageDebFolder)/$(TempFolder).deb"/>

    <RemoveDir Directories="$(PackageTempFolder)" />
  </Target>
</Project>
